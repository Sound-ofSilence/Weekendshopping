# ===== PostgreSQL =====
POSTGRES_USER=taobao
POSTGRES_PASSWORD=taobao
POSTGRES_DB=taobao
DATABASE_URL=postgresql://taobao:taobao@localhost:5432/taobao?schema=public

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ===== RabbitMQ =====
RABBITMQ_DEFAULT_USER=taobao
RABBITMQ_DEFAULT_PASS=taobao
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://taobao:taobao@localhost:5672

# ===== Elasticsearch =====
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200

# ===== JWT =====
JWT_SECRET=please-change-me
JWT_EXPIRES_IN=7d
