generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

model User {
  id           Int        @id @default(autoincrement())
  phone        String     @unique
  email        String?
  passwordHash String     @map("password_hash")
  nickname     String?
  avatar       String?
  gender       Int?
  birthday     DateTime?
  status       Int        @default(1)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  roles     UserRole[]
  addresses UserAddress[]
  realname  UserRealname?

  @@map("users")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  roleCode  String   @map("role_code")
  scopeId   Int?     @map("scope_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleCode, scopeId])
  @@index([userId])
  @@map("user_roles")
}

model UserAddress {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  receiver  String    @map("receiver")
  phone     String    @map("phone")
  province  String    @map("province")
  city      String    @map("city")
  district  String    @map("district")
  detail    String    @map("detail")
  isDefault Boolean   @default(false) @map("is_default")
  tag       String?   @map("tag")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

model UserRealname {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique @map("user_id")
  realName   String    @map("real_name")
  idCardEnc  String    @map("id_card_enc")
  status     Int       @default(0) @map("status")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_realnames")
}

model Category {
  id        Int       @id @default(autoincrement())
  parentId  Int?      @map("parent_id")
  name      String
  level     Int
  sort      Int       @default(0)
  icon      String?
  isLeaf    Boolean   @default(false) @map("is_leaf")
  status    Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  spus Spu[]

  @@index([parentId, status])
  @@map("categories")
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  logo      String?
  status    Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  spus Spu[]

  @@map("brands")
}

model Spu {
  id          Int       @id @default(autoincrement())
  shopId      Int       @map("shop_id")
  categoryId  Int       @map("category_id")
  brandId     Int?      @map("brand_id")
  title       String
  subtitle    String?
  mainImg     String    @map("main_img")
  imagesJson  Json      @map("images_json")
  detailHtml  String    @map("detail_html") @db.Text
  status      Int       @default(0)
  auditStatus Int       @default(0) @map("audit_status")
  auditReason String?   @map("audit_reason")
  salesCount  Int       @default(0) @map("sales_count")
  ratingAvg   Decimal   @default(5.0) @map("rating_avg") @db.Decimal(3, 2)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  category Category @relation(fields: [categoryId], references: [id])
  brand    Brand?   @relation(fields: [brandId], references: [id])
  skus     Sku[]
  specs    SpuSpec[]

  @@index([shopId, status])
  @@index([categoryId, status])
  @@map("spus")
}

model Sku {
  id          Int       @id @default(autoincrement())
  spuId       Int       @map("spu_id")
  specJson    Json      @map("spec_json")
  skuCode     String?   @unique @map("sku_code")
  price       Decimal   @db.Decimal(10, 2)
  marketPrice Decimal?  @map("market_price") @db.Decimal(10, 2)
  costPrice   Decimal?  @map("cost_price") @db.Decimal(10, 2)
  stock       Int       @default(0)
  lockedStock Int       @default(0) @map("locked_stock")
  warnStock   Int       @default(0) @map("warn_stock")
  image       String?
  status      Int       @default(1)
  weight      Decimal?  @db.Decimal(10, 2)
  volume      Decimal?  @db.Decimal(10, 2)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  spu Spu @relation(fields: [spuId], references: [id], onDelete: Cascade)

  @@index([spuId])
  @@map("skus")
}

model SpuSpec {
  id         Int    @id @default(autoincrement())
  spuId      Int    @map("spu_id")
  name       String
  valuesJson Json   @map("values_json")
  sort       Int    @default(0)

  spu Spu @relation(fields: [spuId], references: [id], onDelete: Cascade)

  @@index([spuId])
  @@map("spu_specs")
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  shopId    Int      @map("shop_id")
  skuId     Int      @map("sku_id")
  quantity  Int      @default(1)
  selected  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, skuId])
  @@index([userId])
  @@map("carts")
}

model Order {
  id             Int       @id @default(autoincrement())
  orderNo        String    @unique @map("order_no")
  userId         Int       @map("user_id")
  shopId         Int       @map("shop_id")
  totalAmount    Decimal   @db.Decimal(10, 2) @map("total_amount")
  payAmount      Decimal   @db.Decimal(10, 2) @map("pay_amount")
  freightAmount  Decimal   @default(0) @db.Decimal(10, 2) @map("freight_amount")
  discountAmount Decimal   @default(0) @db.Decimal(10, 2) @map("discount_amount")
  status         Int       @default(0)
  payStatus      Int       @default(0) @map("pay_status")
  shipStatus     Int       @default(0) @map("ship_status")
  receiverJson   Json      @map("receiver_json")
  buyerRemark    String?   @map("buyer_remark")
  channel        Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  paidAt         DateTime? @map("paid_at")
  shippedAt      DateTime? @map("shipped_at")
  finishedAt     DateTime? @map("finished_at")
  closedAt       DateTime? @map("closed_at")

  items OrderItem[]

  @@index([userId, status, createdAt])
  @@map("orders")
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  spuId        Int      @map("spu_id")
  skuId        Int      @map("sku_id")
  spuTitle     String   @map("spu_title")
  skuSpec      Json     @map("sku_spec")
  skuImage     String?  @map("sku_image")
  price        Decimal  @db.Decimal(10, 2)
  quantity     Int
  total        Decimal  @db.Decimal(10, 2)
  refundStatus Int      @default(0) @map("refund_status")
  createdAt    DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id            Int       @id @default(autoincrement())
  paymentNo     String    @unique @map("payment_no")
  orderId       Int       @map("order_id")
  orderNo       String    @map("order_no")
  userId        Int       @map("user_id")
  amount        Decimal   @db.Decimal(10, 2)
  status        Int       @default(0)
  channel       Int       @default(0)
  transactionNo String?   @map("transaction_no")
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([orderId])
  @@map("payments")
}

model Refund {
  id           Int       @id @default(autoincrement())
  refundNo     String    @unique @map("refund_no")
  orderId      Int       @map("order_id")
  orderNo      String    @map("order_no")
  userId       Int       @map("user_id")
  amount       Decimal   @db.Decimal(10, 2)
  reason       String
  status       Int       @default(0)
  thirdPartyNo String?   @map("third_party_no")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([orderId])
  @@map("refunds")
}

model FreightTemplate {
  id              Int      @id @default(autoincrement())
  shopId          Int      @map("shop_id")
  name            String
  chargeType      Int      @default(1)
  firstCount      Int      @map("first_count")
  firstFee        Decimal  @db.Decimal(10, 2) @map("first_fee")
  extraCount      Int      @map("extra_count")
  extraFee        Decimal  @db.Decimal(10, 2) @map("extra_fee")
  freeRegions     Json     @map("free_regions")
  excludedRegions Json     @map("excluded_regions")
  status          Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([shopId, status])
  @@map("freight_templates")
}

model Shipment {
  id             Int             @id @default(autoincrement())
  orderId        Int             @unique @map("order_id")
  orderNo        String          @map("order_no")
  shopId         Int             @map("shop_id")
  expressCompany String          @map("express_company")
  expressCode    String          @map("express_code")
  trackingNo     String          @map("tracking_no")
  status         Int             @default(0)
  shippedAt      DateTime        @map("shipped_at")
  receivedAt     DateTime?       @map("received_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  traces LogisticsTrace[]

  @@index([trackingNo])
  @@map("shipments")
}

model LogisticsTrace {
  id          Int      @id @default(autoincrement())
  shipmentId  Int      @map("shipment_id")
  traceTime   DateTime @map("trace_time")
  description String
  status      Int
  createdAt   DateTime @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, traceTime])
  @@map("logistics_traces")
}

model Review {
  id            Int       @id @default(autoincrement())
  orderItemId   Int       @unique @map("order_item_id")
  userId        Int       @map("user_id")
  spuId         Int       @map("spu_id")
  skuId         Int       @map("sku_id")
  shopId        Int       @map("shop_id")
  rating        Int
  content       String    @db.Text
  imagesJson    Json      @map("images_json")
  isAnonymous   Boolean   @default(false) @map("is_anonymous")
  sellerReply   String?   @db.Text @map("seller_reply")
  sellerReplyAt DateTime? @map("seller_reply_at")
  status        Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([spuId, status])
  @@index([userId])
  @@index([shopId])
  @@map("reviews")
}

model AfterSale {
  id                Int       @id @default(autoincrement())
  afterSaleNo       String    @unique @map("after_sale_no")
  orderId           Int       @map("order_id")
  orderNo           String    @map("order_no")
  orderItemId       Int       @map("order_item_id")
  userId            Int       @map("user_id")
  shopId            Int       @map("shop_id")
  type              Int
  reason            String
  description       String?   @db.Text
  evidenceJson      Json?     @map("evidence_json")
  amount            Decimal   @db.Decimal(10, 2)
  status            Int       @default(0)
  returnTrackingNo  String?   @map("return_tracking_no")
  returnExpressCode String?   @map("return_express_code")
  sellerReply       String?   @map("seller_reply")
  sellerReplyAt     DateTime? @map("seller_reply_at")
  refundNo          String?   @map("refund_no")
  closedAt          DateTime? @map("closed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([userId])
  @@index([shopId, status])
  @@map("after_sales")
}

model Coupon {
  id            Int      @id @default(autoincrement())
  shopId        Int?     @map("shop_id")
  name          String
  type          Int
  value         Decimal  @db.Decimal(10, 2)
  minAmount     Decimal  @db.Decimal(10, 2) @map("min_amount")
  totalCount    Int      @map("total_count")
  receivedCount Int      @default(0) @map("received_count")
  usedCount     Int      @default(0) @map("used_count")
  perUserLimit  Int      @default(1) @map("per_user_limit")
  startAt       DateTime @map("start_at")
  endAt         DateTime @map("end_at")
  status        Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([shopId, status])
  @@index([startAt, endAt])
  @@map("coupons")
}

model UserCoupon {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  couponId   Int       @map("coupon_id")
  orderId    Int?      @map("order_id")
  status     Int       @default(0)
  receivedAt DateTime  @map("received_at")
  usedAt     DateTime? @map("used_at")
  expiredAt  DateTime  @map("expired_at")

  @@index([userId, status])
  @@unique([userId, couponId, receivedAt])
  @@map("user_coupons")
}
model Promotion {
  id        Int      @id @default(autoincrement())
  shopId    Int      @map("shop_id")
  name      String
  rulesJson Json     @map("rules_json")
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")
  status    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([shopId, status])
  @@map("promotions")
}

model SeckillActivity {
  id        Int      @id @default(autoincrement())
  name      String
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")
  status    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("seckill_activities")
}

model SeckillProduct {
  id           Int      @id @default(autoincrement())
  activityId   Int      @map("activity_id")
  skuId        Int      @map("sku_id")
  seckillPrice Decimal  @map("seckill_price") @db.Decimal(10, 2)
  stock        Int
  soldCount    Int      @default(0) @map("sold_count")
  limitPerUser Int      @default(1) @map("limit_per_user")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([activityId, skuId])
  @@index([skuId])
  @@map("seckill_products")
}
